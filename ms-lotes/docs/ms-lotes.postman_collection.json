{
  "info": {
    "name": "ms-lotes",
    "description": "Casos de prueba de ms-lotes (puerto 3005). Casos 1 a 13: CRUD. Casos 14 a 18: seguridad con JWT. Casos 19 a 24: relacion con ms-productos. El caso 3 (?ids=) no aplica. Requiere las variables de coleccion token_admin, token_comercial y token_produccion (obtenidas con POST http://localhost:3001/usuarios/login). Ejecutar en orden con la base reiniciada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token_admin}}", "type": "string" }]
  },
  "variable": [
    { "key": "token_admin", "value": "" },
    { "key": "token_comercial", "value": "" },
    { "key": "token_produccion", "value": "" }
  ],

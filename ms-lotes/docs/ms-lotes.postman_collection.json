        {
          "name": "Caso 18 · 201 produccion crea un lote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/lotes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "lotes"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_produccion}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo_lote\": \"{{codigo_nuevo}}\",\n  \"producto_id\": {{producto_id}},\n  \"fecha_produccion\": \"2026-11-01\",\n  \"cantidad\": 10,\n  \"resultado_calidad\": \"pendiente\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('codigo_nuevo', 'L-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201', () => pm.response.to.have.status(201));",
                  "let id = null;",
                  "try {",
                  "  const d = pm.response.json();",
                  "  id = d.id ?? (d.lote && d.lote.id) ?? (d.data && d.data.id) ?? null;",
                  "} catch (e) { /* sin cuerpo JSON */ }",
                  "if (id === null) {",
                  "  const loc = pm.response.headers.get('Location');",
                  "  if (loc) id = loc.split('/').pop();",
                  "}",
                  "pm.test('Se obtuvo el id del lote creado', () => pm.expect(id).to.not.equal(null));",
                  "if (id !== null) pm.collectionVariables.set('lote_id', String(id));"
                ]
              }
            }
          ]
        },

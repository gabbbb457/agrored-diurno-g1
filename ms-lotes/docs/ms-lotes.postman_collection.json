  "item": [
    {
      "name": "0. Inicio de sesión (guarda los tokens)",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/usuarios/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('Devuelve token', () => pm.expect(d.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token_admin', d.token);"
                ]
              }
            }
          ]
        },

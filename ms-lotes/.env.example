# Puerto donde escucha este microservicio.
PORT=3005

# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (el gateway Apache estará en ese mismo equipo)
HOST=127.0.0.1

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lotes_db
DB_USER=lotes_user
DB_PASSWORD=cambiar-por-su-clave
# Clave compartida del grupo para verificar tokens JWT (debe ser la misma en todos los servicios)
JWT_SECRET=cambiar-por-la-clave-del-grupo
# Dirección de ms-productos (relación producto_id)
PRODUCTOS_URL=http://127.0.0.1:3002
# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha este microservicio (ms-clientes = 3003).
PORT=3003
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (el gateway Apache estará en ese mismo equipo)
HOST=127.0.0.1

# Base de datos propia del microservicio (patrón base de datos por servicio)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clientes_db
DB_USER=clientes_user
DB_PASSWORD=cambie-esta-clave

# Clave con la que se verifican los tokens JWT.
# DEBE SER LA MISMA en todos los microservicios del grupo (la acuerda el grupo; no se sube).
JWT_SECRET=cambie-esta-frase-por-la-del-grupo

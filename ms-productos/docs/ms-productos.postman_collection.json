          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Código 200', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [

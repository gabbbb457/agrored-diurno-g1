# Puerto donde escucha ms-productos
PORT=3002
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (el gateway Apache estará en ese mismo equipo)
HOST=127.0.0.1

# Conexión a MySQL (base de datos propia de ms-productos)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=productos_db
DB_USER=productos_user
DB_PASSWORD=cambie-esta-clave